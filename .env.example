# Copy to .env. Every variable is optional: with nothing set, the app runs with the mock evaluator.

# Which LLM evaluates designs: mock | anthropic | openai.
# If anthropic/openai is chosen but its key is missing, the app falls back to mock and logs a warning.
LLM_PROVIDER=mock

# Model id. Anthropic default: claude-sonnet-5-5. OpenAI has no default and requires this.
# LLM_MODEL=claude-sonnet-5-5

# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Per-call timeout and retries for LLM calls (exponential backoff: base, 2x base, ...).
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=1000

# Artificial delay for the mock evaluator, so the "Evaluating" state is visible in the UI.
MOCK_LATENCY_MS=1500

# How often the in-process worker polls the jobs table.
WORKER_POLL_MS=2000

PORT=3000
DB_PATH=lld-practice.db
